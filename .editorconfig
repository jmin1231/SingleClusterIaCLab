# Baseline formatting, so shfmt and ruff agree with each other and with you.
# shfmt reads this file — without it, it defaults to tabs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# PEP 8, which ruff enforces and will not be argued with.
[*.py]
indent_size = 4

# Trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
