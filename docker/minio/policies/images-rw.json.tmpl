{
  "Version": "2012-10-17",
  "Statement": [
    {
      "_comment_TODO_1": "The image-upload account, used by 6.1 and 6.2. Read/write on ${IMAGES_BUCKET} only.",
      "_comment_TODO_2": "This is the account 5.1's done-when tests: it must be DENIED listing the state bucket. That denial should fall out of this policy naming only ${IMAGES_BUCKET} — not from an explicit Deny. An implicit deny is the stronger result, because it survives someone later adding a broad Allow elsewhere.",
      "_comment_TODO_3": "Do not grant DeleteObject unless 6.x actually needs it. An upload key that cannot delete is a meaningfully smaller blast radius, and versioning means overwrites are recoverable anyway.",
      "Effect": "Allow",
      "Action": [],
      "Resource": []
    }
  ]
}

{
  "Version": "2012-10-17",
  "Statement": [
    { "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::${BUCKET}"] },
    { "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListMultipartUploadParts", "s3:AbortMultipartUpload"],
      "Resource": ["arn:aws:s3:::${BUCKET}/*"] }
  ]
}