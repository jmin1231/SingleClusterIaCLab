# Rendered by proxy-installer.sh with envsubst. ${CLOUDBR0_IP} is discovered from
# the bridge, so this file is a template and the rendered copy is gitignored.

# Everything on :80 is redirected. No service is served over plain HTTP — the
# whole reason this exists is that CloudStack's login was cleartext.
server {
    listen 80 default_server;
    server_name _;
    return 308 https://$host$request_uri;
}

# The default server for :443, and it must come first. Without an explicit one,
# nginx promotes the FIRST server block on an address to default_server — so the
# CloudStack block answered for vault.lab.test, minio.lab.test and every other
# name that resolves to this host, presenting CloudStack's certificate for all of
# them. A name mismatch is only a warning, and warnings get clicked through.
#
# ssl_reject_handshake refuses at the TLS layer, so no certificate is offered at
# all: an unknown name fails to connect rather than failing to validate. Vault is
# the case that matters — it is NOT behind this proxy (3.4-1) and lives at
# vault.lab.test:8200, so :443 must not pretend to serve it.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name cloudstack.lab.test;

    ssl_certificate     /etc/nginx/certs/cloudstack.lab.test.crt;
    ssl_certificate_key /etc/nginx/certs/cloudstack.lab.test.key;

    # TLS 1.2 is kept because CloudStack's own console proxy and some CLI tools
    # are older than 1.3. Narrow it once nothing needs it.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location / {
        proxy_pass http://${CLOUDBR0_IP}:8080;

        # Host is what CloudStack builds redirects and cookie domains from; get
        # it wrong and login loops without an error, which is the war story in
        # build-order 2.5.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # The UI opens a websocket for the console; without these it degrades to
        # polling and the console tab stays blank.
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name gitea.lab.test;

    ssl_certificate     /etc/nginx/certs/gitea.lab.test.crt;
    ssl_certificate_key /etc/nginx/certs/gitea.lab.test.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # git push of a large repo is not a web form. Gitea's own docs call this out
    # as the first thing a reverse proxy gets wrong.
    client_max_body_size 512M;

    location / {
        proxy_pass http://${CLOUDBR0_IP}:3000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
