        </mxCell>
        <mxCell id="wan" value="&lt;b&gt;wan · 198.51.100.0/24 · host gateway 198.51.100.1&lt;/b&gt;&lt;br&gt;eth1 on every VM · WG transport: fe-1 → hub UDP 51820; be-1 → hub UDP 51821&lt;br&gt;Host nftables blocks other VM-to-VM WAN traffic and direct routed egress." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="650" width="1420" height="105" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="&lt;b&gt;fe-1 · frontend + VPN&lt;/b&gt;&lt;br&gt;1 vCPU · 1 GiB · 10 GiB disk&lt;br&gt;&lt;br&gt;eth0 10.1.1.10/24 · site-a&lt;br&gt;eth1 198.51.100.11/24 · wan&lt;br&gt;eth2 10.250.0.110/24 · mgmt&lt;br&gt;wg0 10.99.0.2/24&lt;br&gt;&lt;br&gt;Gunicorn TLS :443 + Flask&lt;br&gt;Podman / Quadlet · host network" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="820" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="&lt;b&gt;tun-1 · WireGuard hub&lt;/b&gt;&lt;br&gt;1 vCPU · 512 MiB · 10 GiB disk&lt;br&gt;&lt;br&gt;eth0 10.2.1.10/24 · site-hub&lt;br&gt;eth1 198.51.100.12/24 · wan&lt;br&gt;eth2 10.250.0.111/24 · mgmt&lt;br&gt;wg0 10.99.0.1/24 · wg1 10.99.1.1/24&lt;br&gt;&lt;br&gt;Forward only 10.1.1.10 →&lt;br&gt;10.3.1.10 TCP 8000 + replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="585" y="820" width="430" height="260" as="geometry" />
        </mxCell>
        <mxCell id="be" value="&lt;b&gt;be-1 · k3s + VPN&lt;/b&gt;&lt;br&gt;2 vCPU · 4 GiB · 40 GiB disk&lt;br&gt;&lt;br&gt;eth0 10.3.1.10/24 · site-c&lt;br&gt;eth1 198.51.100.13/24 · wan&lt;br&gt;eth2 10.250.0.112/24 · mgmt&lt;br&gt;wg1 10.99.1.2/24&lt;br&gt;&lt;br&gt;Flux · PostgREST :8000&lt;br&gt;PostgreSQL ClusterIP :5432" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="820" width="390" height="260" as="geometry" />
        </mxCell>
        <mxCell id="private" value="Private bridges site-a / site-hub / site-c have no host IP or default gateway.&lt;br&gt;WG carries private /16 routes; application traffic uses 10.1.1.10 → 10.3.1.10." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#334155;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1340" width="1520" height="50" as="geometry" />
        </mxCell>
        <mxCell id="mgmt" value="&lt;b&gt;cloudbr1 · 10.250.0.0/24 · host 10.250.0.1 · eth2 on every VM&lt;/b&gt;&lt;br&gt;Runner → VMs SSH :22 (configuration + frontend.tar); DNS :53; chrony :123; Squid :3128&lt;br&gt;be-1 → Traefik/Gitea :443 permitted; guest-to-guest management blocked. General host input allowlist remains future work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="1190" width="1420" height="100" as="geometry" />
        </mxCell>
