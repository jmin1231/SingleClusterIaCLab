        <mxCell id="lan-note" value="LAN card / HOST_IP discovered live. No cloudbr0 or CloudStack. cfssl issues the lab certificates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#334155;spacing=0;" vertex="1" parent="1">
