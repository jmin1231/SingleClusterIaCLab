<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="traffic" name="Request flow">
    <mxGraphModel dx="1500" dy="1390" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1390" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Request flow — browser to todo.items&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=26;fontColor=#334155;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1420" height="42" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="2026-11-18 · Configuration view · Frontend role exists; full deployment acceptance is still pending in build-order.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontColor=#334155;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="67" width="1420" height="45" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;1 · LAN browser&lt;/b&gt;&lt;br&gt;https://app.lab.test → host LAN IP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="660" height="85" as="geometry" />
        </mxCell>
        <mxCell id="dnat" value="&lt;b&gt;2 · Host nftables DNAT&lt;/b&gt;&lt;br&gt;LAN ingress HOST_IP:443 → 198.51.100.11:443&lt;br&gt;Browser TLS remains intact; no application proxy on the host" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="280" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="&lt;b&gt;3 · fe-1: Gunicorn TLS + Flask&lt;/b&gt;&lt;br&gt;Host-network Podman container · listens on :443 · UID 65532&lt;br&gt;Server-side API call: http://10.3.1.10:8000/items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="440" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="hub" value="&lt;b&gt;4 · tun-1: WireGuard hub&lt;/b&gt;&lt;br&gt;Decrypt wg0 → filter → encrypt wg1&lt;br&gt;Allow 10.1.1.10 → 10.3.1.10 TCP 8000 and replies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="620" width="660" height="110" as="geometry" />
        </mxCell>
        <mxCell id="be" value="&lt;b&gt;5 · be-1: PostgREST Service&lt;/b&gt;&lt;br&gt;Private destination 10.3.1.10:8000 via wg1&lt;br&gt;LoadBalancer Service → targetPort http (:3000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="800" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rest" value="&lt;b&gt;6 · PostgREST pod · namespace db&lt;/b&gt;&lt;br&gt;Connect as authenticator; switch to web_anon&lt;br&gt;Expose schema todo as REST endpoints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="960" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;7 · PostgreSQL pod via Service postgres:5432&lt;/b&gt;&lt;br&gt;Database todo · table todo.items&lt;br&gt;id / name / created_at · persistent volume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="1120" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dns" value="&lt;b&gt;DNS&lt;/b&gt;&lt;br&gt;CoreDNS answers app.lab.test&lt;br&gt;with the detected host LAN IP.&lt;br&gt;No VPC public-IP allocation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="tls" value="&lt;b&gt;TLS ends on fe-1&lt;/b&gt;&lt;br&gt;Lab CA signs app-edge cert.&lt;br&gt;Pipeline gets it from Vault KV.&lt;br&gt;No Caddy / loopback :8080 hop." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="320" height="125" as="geometry" />
        </mxCell>
        <mxCell id="wg" value="&lt;b&gt;WireGuard transport on wan&lt;/b&gt;&lt;br&gt;fe-1 → 198.51.100.12:51820&lt;br&gt;be-1 → 198.51.100.12:51821&lt;br&gt;&lt;br&gt;wg0: 10.99.0.2 ↔ 10.99.0.1&lt;br&gt;wg1: 10.99.1.1 ↔ 10.99.1.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="500" width="320" height="185" as="geometry" />
        </mxCell>
        <mxCell id="encryption" value="&lt;b&gt;Encryption boundary&lt;/b&gt;&lt;br&gt;Backend HTTP is encrypted on&lt;br&gt;each WireGuard link.&lt;br&gt;The hub can read it after decapsulation.&lt;br&gt;No end-to-end mTLS or mesh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="management" value="&lt;b&gt;Separate management plane&lt;/b&gt;&lt;br&gt;cloudbr1 · eth2 · 10.250.0.0/24&lt;br&gt;Host runner → guests over SSH.&lt;br&gt;Frontend image delivered as tar.&lt;br&gt;Vault supplies secrets through CI;&lt;br&gt;no Vault call on an app request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="830" width="320" height="175" as="geometry" />
        </mxCell>
        <mxCell id="policy" value="&lt;b&gt;Isolation in the code&lt;/b&gt;&lt;br&gt;No direct fe-1 ↔ be-1 WAN path.&lt;br&gt;Guest-to-guest mgmt blocked.&lt;br&gt;Hub drops other forwarded traffic.&lt;br&gt;VM internet egress uses Squid.&lt;br&gt;Host input allowlist is future work." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;fontSize=15;strokeWidth=1.5;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="Responses return along the same application path. PostgreSQL :5432 is ClusterIP-only, not exposed by the frontend-facing LoadBalancer.&lt;br&gt;Not in this request path: Istio gateway / mesh, Vault Transit, CloudNativePG. Companion: request-flow.md." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=15;fontColor=#334155;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1280" width="1420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="hop-0" value="HTTPS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="dnat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hop-1" value="DNAT :443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dnat" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hop-2" value="HTTP inside wg0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="fe" target="hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hop-3" value="HTTP inside wg1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7c3aed;fontColor=#7c3aed;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hub" target="be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hop-4" value="HTTP :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="be" target="rest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hop-5" value="PostgreSQL :5432" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#475569;fontColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rest" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>