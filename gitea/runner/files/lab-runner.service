[Unit]
Description=Lab Gitea Actions runner
After=network-online.target
Wants=network-online.target

[Service]
User=root
Group=root
WorkingDirectory=/var/lib/lab/runner
# /var/lib/lab/tfstate: Terraform's state (terraform/provider.tf) and TMPDIR (terraform.yml)
# /var/lib/lab/images: the frontend image tarball, image.yml writes it and the frontend role copies it to fe-1
StateDirectory=lab/tfstate lab/images
StateDirectoryMode=0700
ExecStart=/usr/local/bin/gitea-runner daemon --config /etc/lab-runner/config.yaml
Restart=on-failure
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
