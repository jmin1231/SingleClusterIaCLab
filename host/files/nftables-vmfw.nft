# --- Switched: VM <-> VM inside one bridge: the security groups ---
# Like a cloud security group: per VM card, stateful (replies to an allowed flow come back on their
# own) and allow-only (a group lists what may reach its cards; everything else is dropped).
# Stateful uses bridge conntrack (nf_conntrack_bridge). The kernel loads it with the first ct rule
# here (nft fails the whole load if it cannot); vmfw.py loads it first so that failure comes earlier.
# Once loaded it tracks frames on every bridge, Podman's and libvirt's too; only the lab's VM cards
# are filtered. Bridge and routed traffic share one conntrack table, which is why the source checks
# run before conntrack and the routed table drops VM -> VM traffic through the host.

table bridge lab_sg
delete table bridge lab_sg

table bridge lab_sg {
    # Group membership: a card is in a group by being in its set (terraform/compute.tf names the taps)
    set sg_frontend {
        type ifname
        elements = { "fe-1-wan" }
    }
    set sg_hub {
        type ifname
        elements = { "tun-1-wan" }
    }
    set sg_backend {
        type ifname
        elements = { "be-1-wan" }
    }
    set mgmt_taps {
        type ifname
        elements = { "fe-1-mgmt", "tun-1-mgmt", "be-1-mgmt" }
    }
    # Every card above. Only frames from these cards (and between them) are filtered: Podman's and
    # libvirt's bridges and mgmtbr1's anchor port are not
    set lab_taps {
        type ifname
        elements = { "fe-1-wan", "tun-1-wan", "be-1-wan", "fe-1-mgmt", "tun-1-mgmt", "be-1-mgmt" }
    }
    # Each card's own address (terraform/compute.tf), for the source and destination checks
    set lab_addrs {
        type ifname . ipv4_addr
        elements = { "fe-1-wan" . 198.51.100.11, "tun-1-wan" . 198.51.100.12, "be-1-wan" . 198.51.100.13,
                     "fe-1-mgmt" . 10.250.0.110, "tun-1-mgmt" . 10.250.0.111, "be-1-mgmt" . 10.250.0.112 }
    }

    # Source checks (a cloud enforces these below its security groups), on every frame a VM card
    # sends, to another VM or to the host, and before conntrack sees it (priority -300; bridge
    # conntrack runs at -200): a card sends only from its own address and announces only that
    # address in ARP. So a VM cannot pass a forged packet off as a reply in another VM's connection,
    # nor poison the host's or the hub's ARP cache to pull another VM's traffic.
    chain prerouting {
        type filter hook prerouting priority -300; policy accept;

        iifname != @lab_taps return
        # No VLAN tags from a VM (they use none). Linux strips a VLAN 0 ("priority") tag and handles the frame as
        # untagged, but the ARP check below matches on the Ethernet type, which a tagged frame reports as the tag's:
        # a tagged ARP would skip it and could point the host's ARP entry for another VM at the sender (tested
        # 2026-11-24). The IP check matches on the protocol inside the tag, so it holds either way.
        ether type { 8021q, 8021ad } counter drop comment "VLAN-tagged"
        iifname . ip saddr != @lab_addrs counter drop comment "spoofed source"
        iifname . arp saddr ip != @lab_addrs counter drop comment "spoofed ARP"
    }

    chain forward {
        type filter hook forward priority filter; policy accept;

        iifname != @lab_taps return
        oifname != @lab_taps return

        # mgmt: no VM-to-VM at all, not even as a "reply"; each VM still talks to the host
        iifname @mgmt_taps counter drop comment "mgmt: VM to VM"

        # Destination check: a card receives only frames for its own address
        oifname . ip daddr != @lab_addrs counter drop comment "wan: wrong destination"

        # ARP carries no connection state, so it is allowed before the stateful rules: only between
        # cards that may talk (each spoke and the hub)
        iifname @sg_frontend oifname @sg_hub ether type arp accept
        iifname @sg_hub oifname @sg_frontend ether type arp accept
        iifname @sg_backend oifname @sg_hub ether type arp accept
        iifname @sg_hub oifname @sg_backend ether type arp accept

        # Stateful: replies to a flow a group allowed, and only between cards a group connects. A
        # bare "ct state established,related accept" would also pass an ICMP error that names another
        # VM's connection (fe-1 -> be-1 naming be-1's tunnel counts as "related")
        iifname @sg_frontend oifname @sg_hub ct state established,related accept
        iifname @sg_hub oifname @sg_frontend ct state established,related accept
        iifname @sg_backend oifname @sg_hub ct state established,related accept
        iifname @sg_hub oifname @sg_backend ct state established,related accept

        # Each group's inbound rules; outbound is open, as in a cloud security group
        oifname @sg_hub jump sg_hub_in
        oifname @sg_frontend jump sg_frontend_in
        oifname @sg_backend jump sg_backend_in

        # Default deny: whatever no group allows (fe-1 <-> be-1, IPv6, other ports and protocols)
        counter drop comment "wan: no security group allows it"
    }

    chain sg_hub_in {
        iifname @sg_frontend ether type ip udp dport 51820 ct state new accept  # WireGuard from the frontend
        iifname @sg_backend ether type ip udp dport 51821 ct state new accept   # WireGuard from the backend
    }

    # No inbound from other VMs: their only peer is the hub, and they start their tunnel themselves
    chain sg_frontend_in {
    }

    chain sg_backend_in {
    }
}

# --- Routed: anything through the host's IP layer (the "internet gateway") ---
table inet lab_vmfw
delete table inet lab_vmfw

table inet lab_vmfw {
    # The LAN's HTTPS reaches fe-1's public address. Only on the LAN card;
    # Traefik listens on 10.250.0.1:443, so it is not affected.
    chain prerouting {
        type nat hook prerouting priority dstnat; policy accept;

        iifname $lan_card ip daddr $host_ip tcp dport 443 dnat ip to 198.51.100.11
    }

    # The same for the host's own browser: prerouting never sees traffic the host itself starts.
    chain output {
        type nat hook output priority dstnat; policy accept;

        ip daddr $host_ip tcp dport 443 dnat ip to 198.51.100.11
    }

    # No VM reaches the LAN or the internet, and none relays through the host: not via
    # 198.51.100.1 (wan) or 10.250.0.1 (mgmt). The tier networks are isolated (the host has no
    # address on them); they are listed as a guard in case one ever gets a host address.
    # Package downloads go through Squid, which is host traffic (input/output), not forwarded.
    # Exception: the VMs reach the services behind Traefik (be-1's Flux pulls from Gitea; every VM's Alloy
    # pushes to prometheus.lab.test and loki.lab.test). Traefik's podman port mapping DNATs 10.250.0.1:443
    # into the podman network, so these requests are forwarded, not input; only this one flow passes.
    chain forward {
        type filter hook forward priority filter; policy accept;

        # No VM reaches another VM through the host, not even as a "reply": routing one VM's packet
        # back out to the VMs is never legitimate. It must come before the established rule, which
        # would otherwise pass an ICMP error naming another VM's connection (routed and bridged
        # flows share one conntrack table, and the host's own SSH sessions into the VMs are in it).
        iifname { "wan", "mgmtbr1" } oifname { "wan", "mgmtbr1" } counter drop

        ct state established,related accept
        iifname $lan_card oifname "wan" ip daddr 198.51.100.11 tcp dport 443 ct status dnat accept

        iifname "wan" counter drop
        oifname "wan" counter drop
        iifname "mgmtbr1" ip saddr { 10.250.0.110, 10.250.0.111, 10.250.0.112 } ct original proto-dst 443 ct status dnat accept
        iifname { "mgmtbr1", "site-a", "site-hub", "site-c" } counter drop
        oifname { "mgmtbr1", "site-a", "site-hub", "site-c" } counter drop
    }

    # VMs reach host services only over mgmt, never over the wan, and on mgmt only what they use:
    # DNS (CoreDNS), NTP (chrony) and Squid. Everything else on the host (sshd on 0.0.0.0, anything
    # added later) is closed to them, on every host address. Traefik's 443 is not here: Podman DNATs
    # it, so it passes the forward chain above. The established rule lets replies to the host's own
    # connections into the VMs (ssh, Ansible from the runner) back in.
    chain input {
        type filter hook input priority filter; policy accept;

        iifname "wan" ct state established,related accept
        iifname "wan" counter drop

        iifname "mgmtbr1" ct state established,related accept
        iifname "mgmtbr1" udp dport { 53, 123 } accept
        iifname "mgmtbr1" tcp dport { 53, 3128 } accept
        iifname "mgmtbr1" icmp type { echo-request, destination-unreachable, time-exceeded } accept
        iifname "mgmtbr1" counter drop
    }
}
