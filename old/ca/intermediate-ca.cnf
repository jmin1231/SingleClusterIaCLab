# Intermediate CA

[ req ]
default_md              = sha256
utf8                    = yes
string_mask             = utf8only
prompt                  = no
distinguished_name      = ca_dn

[ ca_dn ]
0.domainComponent       = "test"
1.domainComponent       = "lab"
organizationName        = "SingleClusterIaCLab"
commonName              = "lab.test Issuing CA"


[ ca ]
default_ca              = intermediate_ca


[ intermediate_ca ]
dir                     = $ENV::CA_DIR
certificate             = $dir/intermediate-ca.crt
private_key             = $dir/intermediate-ca.key.enc
new_certs_dir           = $dir/newcerts
database                = $dir/index.txt
serial                  = $dir/serial
default_md              = sha256
default_days            = 397
policy                  = leaf_pol
x509_extensions         = leaf_ext
rand_serial             = yes
copy_extensions         = none
unique_subject          = no


# What a leaf CSR must carry. `match` means present AND equal to this CA's own
# field, so issue-leaf.sh has to build the full DN, not just a CN. Anything not
# listed here is silently dropped from the issued certificate.
[ leaf_pol ]
domainComponent         = match
organizationName        = match
commonName              = supplied


# Extensions placed ON the leaf. $ENV::LEAF_SAN expands when this file is LOADED,
# not when this section is used, so every openssl command reading this config must
# set it — including the intermediate's own CSR, where LEAF_SAN="" is correct.
[ leaf_ext ]
basicConstraints        = critical,CA:false
keyUsage                = critical,digitalSignature,keyEncipherment
extendedKeyUsage        = serverAuth
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always
subjectAltName          = $ENV::LEAF_SAN
