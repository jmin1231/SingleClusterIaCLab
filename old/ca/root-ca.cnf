# Root CA

# The next part of the configuration file is used by the openssl req command.
# It defines the CA's DN and the extensions of the CA certificate. The key pair
# itself is not made here — root-ca-create.sh generates RSA-4096 with genpkey
# before req ever runs, so [ req ] carries no default_bits.

[ req ]
default_md              = sha256                # MD to use (pairs with RSA-4096)
utf8                    = yes                   # Input is UTF-8
string_mask             = utf8only              # Emit UTF-8 strings
prompt                  = no                    # Don't prompt for DN
distinguished_name      = ca_dn                 # DN section
x509_extensions         = root_ca_ext           # Desired extensions

[ ca_dn ]
0.domainComponent       = "test"
1.domainComponent       = "lab"
organizationName        = "SingleClusterIaCLab"
commonName              = "lab.test Root CA"

[ ca ]
default_ca              = root_ca

[ root_ca ]
dir                     = $ENV::CA_DIR
certificate             = $dir/root-ca.crt
private_key             = $dir/root-ca.key.enc
new_certs_dir           = $dir/newcerts
database                = $dir/index.txt
serial                  = $dir/serial
default_md              = sha256
default_days            = 3650
policy                  = intermediate_pol
x509_extensions         = intermediate_ca_ext
rand_serial             = yes
copy_extensions         = none
unique_subject          = no

# What the root requires of a CSR before it will sign it. The intermediate must
# live in the same organisation, and must name itself something else. Used for
# CSRs this repo generates with `openssl req`, which is intermediate-ca-create.sh.
[ intermediate_pol ]
domainComponent         = match
organizationName        = match
commonName              = supplied


# The same job for a CSR generated by Vault's PKI engine (3.4). It is weaker, and
# not by choice: `match` is unsatisfiable for a Vault CSR on EVERY field, for two
# independent reasons found by trying it.
#
# 1. Vault's CSR vocabulary has no domainComponent at all — common_name,
#    organization, ou, country, locality, province, street_address, postal_code
#    and serial_number, and nothing else.
#
# 2. `match` compares the ASN.1 STRING TYPE as well as the characters. Line 11
#    sets string_mask = utf8only, so this CA's DN is UTF8String; Vault uses Go's
#    crypto/x509, which emits PrintableString whenever the characters allow. The
#    failure reads "The organizationName field is different between CA
#    certificate (SingleClusterIaCLab) and the request (SingleClusterIaCLab)" —
#    two identical strings declared different, with no mention of encoding.
#
# Re-encoding the CSR is not a way out: the subject is covered by the CSR's own
# self-signature, and re-signing needs the private key, which never leaves Vault.
#
# What actually constrains Vault is not this section. It is intermediate_ca_ext
# with copy_extensions = none: whatever the CSR requests is discarded and the
# root stamps CA:true, pathlen:0 — so Vault gets exactly the authority the root
# decides to give it, and can never mint a sub-CA. DN policy is the weak control
# here; the extensions are the strong one.
[ vault_intermediate_pol ]
domainComponent         = optional
organizationName        = supplied
commonName              = supplied


# Certificate extensions define what types of certificates the CA is able to
# create.

[ root_ca_ext ]
keyUsage                = critical,keyCertSign,cRLSign
basicConstraints        = critical,CA:true,pathlen:1
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always


[ intermediate_ca_ext ]
keyUsage                = critical,keyCertSign,cRLSign
basicConstraints        = critical,CA:true,pathlen:0
subjectKeyIdentifier    = hash
authorityKeyIdentifier  = keyid:always
