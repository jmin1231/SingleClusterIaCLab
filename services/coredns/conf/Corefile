# lab.test: answered from the hosts list below
lab.test:53 {
    bind 10.250.0.1 {$HOST_IP}
    hosts {
        10.250.0.1 gitea.lab.test vault.lab.test proxy.lab.test grafana.lab.test prometheus.lab.test loki.lab.test
        {$HOST_IP} app.lab.test
        10.250.0.112 k3s.lab.test
    }
    errors
    log
    reload
}

# Everything outside lab.test: refused, and logged. The VMs reach the internet only through Squid,
# which resolves names itself on the host, so a recursive resolver here would only give a VM or pod
# a way to send data out in DNS queries (around Squid's allowlist). With no block for a name CoreDNS
# would refuse it anyway, but silently; this block logs each refused query (journal -> Loki).
.:53 {
    bind 10.250.0.1 {$HOST_IP}

    template ANY ANY {
        rcode REFUSED
    }

    errors
    log
}
