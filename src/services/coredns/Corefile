# lab.test: answered from the hosts list below
lab.test:53 {
    bind 10.250.0.1 {$HOST_IP}
    hosts {
        10.250.0.1 cloudstack.lab.test gitea.lab.test
    }
    errors
    log
}

# everything else: forwarded to systemd-resolved, which sends it to the host's upstream DNS.
# No loop: resolved only sends lab.test here, and the block above answers lab.test.
.:53 {
    bind 10.250.0.1 {$HOST_IP}
    forward . 127.0.0.53
    cache 30
    errors
    log
}
