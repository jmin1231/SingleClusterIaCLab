[Unit]
Description=Lab Gitea Actions runner
After=network-online.target
Wants=network-online.target

[Service]
User=lab-runner
Group=lab-runner
WorkingDirectory=/var/lib/lab/runner
ExecStart=/usr/local/bin/gitea-runner daemon --config /etc/lab-runner/config.yaml
Restart=on-failure
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
