version: 2
ethernets:
    eth0:
        match:
            macaddress: "${vpc_mac}"
        set-name: eth0
        addresses: [${vpc_ip}/24]
    eth1:
        match:
            macaddress: "${wan_mac}"
        set-name: eth1
        addresses: [${wan_ip}/24]
        routes:
            - to: default
              via: 198.51.100.1
    eth2:
        match:
            macaddress: "${mgmt_mac}"
        set-name: eth2
        addresses: [${mgmt_ip}/24]
        nameservers:
            addresses: [10.250.0.1]